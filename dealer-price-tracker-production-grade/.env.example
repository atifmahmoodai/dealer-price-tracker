# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# docker-compose builds DATABASE_URL from POSTGRES_PASSWORD. Outside Docker set it yourself:
# DATABASE_URL=postgres://tracker:PASSWORD@localhost:5432/tracker

# --- Web ---
# The address users open (https in production). Used in digest email links and the CSRF origin check.
PUBLIC_URL=http://localhost:8080
# Behind nginx / Caddy / a cloud load balancer that terminates https:
TRUST_PROXY=false
# Secure cookies need https. Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false
NODE_ENV=production
APP_PORT=8080

# Time zone (IANA name) for the daily scrape time and snapshot dates.
TIMEZONE=America/New_York

# --- Scraper ---
# Runs the daily scrape from this process (several instances coordinate, so leaving it on everywhere is fine).
SCHEDULER=true
# Never turn this on in production: it lets competitor URLs point at your private network.
SCRAPER_ALLOW_PRIVATE=false
SCRAPER_MAX_PAGE_MB=8

# --- Email (optional) ---
# Without SMTP_URL the daily digest is only logged. Format: smtp(s)://user:pass@host:port
# SMTP_URL=smtps://apikey:SECRET@smtp.example.com:465
MAIL_FROM=Price Tracker <no-reply@example.com>

# --- Sessions ---
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=12

LOG_LEVEL=info
RATE_LIMIT_PER_MIN=300
