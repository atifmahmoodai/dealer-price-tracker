      "card": ".listing-card",
      "title": ".listing-title",
      "price": ".listing-price",
      "link": "a.listing-link@href",
      "mileage": ".listing-mileage",
      "vin": ".listing-vin",
      "stockNo": ".listing-stock"
    },
    "maxPages": 20,
    "delayMs": 3000
  }
